    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#dateTime -->

    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#dateTime">
        <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://edint.es/def/censo-vehiculos#authorisesInSegment -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#authorisesInSegment">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:comment xml:lang="es">Identifica el segmento de vía para el cual la autorización da permiso para pasar o aparcar</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies a segment where the permit authorises the vehicle to go through or park</rdfs:comment>
        <rdfs:label xml:lang="en">authorises in segment</rdfs:label>
        <rdfs:label xml:lang="es">autoriza en tramo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#authorisesVehicle -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#authorisesVehicle">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:comment xml:lang="es">Identifica el vehículo al que se refiere la autorización</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the vehicle for which the permit is issued</rdfs:comment>
        <rdfs:label xml:lang="en">authorises vehicle</rdfs:label>
        <rdfs:label xml:lang="es">autoriza vehículo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#environmentalBadge -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#environmentalBadge">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehicleEnvironmentalBadge"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Distintivo ambiental asignado a un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, ECO, B, C, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">Environmental badge assigned to a vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., ECO, B, C, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">distintivo ambiental del vehículo</rdfs:label>
        <rdfs:label xml:lang="en">environmental badge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#permitOwner -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#permitOwner">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="https://edint.es/def/censo-vehiculos#Owner"/>
        <rdfs:comment xml:lang="es">Identifica al titular (persona u organización) para el cual la autorización está expedida</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the person or organisation for which the permit has been issued</rdfs:comment>
        <rdfs:label xml:lang="en">permit owner</rdfs:label>
        <rdfs:label xml:lang="es">titular autorización</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#permitPeriodicity -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#permitPeriodicity">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehiclePermitPeriodicity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Identifica la periodicidad de la autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, mensual, anual, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the periodicity of a vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., monhtly, annual, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">periodicidad de la autorización</rdfs:label>
        <rdfs:label xml:lang="en">permit periodicity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#permitStatus -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#permitStatus">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehiclePermitStatus"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Identifica el estado de la autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, activo, inactivo, rechazado, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the status of a vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., active, inactive, rejected, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">estado de autorización</rdfs:label>
        <rdfs:label xml:lang="en">permit status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#permitType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#permitType">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehiclePermitType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Identifica el tipo de autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización.</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the type of vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types.</rdfs:comment>
        <rdfs:label xml:lang="en">permit type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de autorizacion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#propulsionType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#propulsionType">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehiclePropulsionType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Propulsion type of a vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., Diesel, Petrol, Electrical, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de propulsión de un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, diésel, gasolina, eléctrico, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">propulsion type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de propulsión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#registeredOwner -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#registeredOwner">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:range rdf:resource="https://edint.es/def/censo-vehiculos#Owner"/>
        <rdfs:comment xml:lang="es">Identifica al titular (persona u organización) del vehículo</rdfs:comment>
        <rdfs:comment xml:lang="en">It identifies the person or organisation who owns the vehicle</rdfs:comment>
        <rdfs:label xml:lang="en">registered owner</rdfs:label>
        <rdfs:label xml:lang="es">titular registrado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#vehicleType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/censo-vehiculos#vehicleType">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/VehicleType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, turismo, furgoneta, caravana, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., van, truck, caravan, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de vehículo</rdfs:label>
        <rdfs:label xml:lang="en">vehicle type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://edint.es/def/censo-vehiculos#activationDate -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/censo-vehiculos#activationDate">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="es">La fecha de activación de la autorización.</rdfs:comment>
        <rdfs:comment xml:lang="en">The date on which the authorization is activated.</rdfs:comment>
        <rdfs:label xml:lang="en">Date of Activation</rdfs:label>
        <rdfs:label xml:lang="es">Fecha de activación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#beginningDate -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/censo-vehiculos#beginningDate">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="es">Fecha de inicio del periodo de la autorización.</rdfs:comment>
        <rdfs:comment xml:lang="en">Starting date of the authorization period.</rdfs:comment>
        <rdfs:label>Beginning Date</rdfs:label>
        <rdfs:label xml:lang="es">Fecha de inicio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#endingDate -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/censo-vehiculos#endingDate">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Permit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="es">Fecha de finalización de vigencia de la autorización</rdfs:comment>
        <rdfs:comment xml:lang="en">Permit expiration date</rdfs:comment>
        <rdfs:label xml:lang="en">Ending date</rdfs:label>
        <rdfs:label xml:lang="es">Fecha de finalización</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/censo-vehiculos#licensePlateNumber -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/censo-vehiculos#licensePlateNumber">
        <rdfs:domain rdf:resource="https://edint.es/def/censo-vehiculos#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Alphanumeric identifier assigned to a vehicle for registration and identification purposes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Identificador alfanumérico asignado a un vehículo para su registro e identificación</rdfs:comment>
        <rdfs:label xml:lang="en">License Plate Number</rdfs:label>
        <rdfs:label xml:lang="es">Número de matrícula</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
