<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/censo-vehiculos#"
     xml:base="https://edint.es/def/censo-vehiculos"
     xmlns:gsp="http://www.opengis.net/spec/geosparql/1.0/"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:esadm="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#"
     xmlns:escjr="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#"
     xmlns:s4auto="https://saref.etsi.org/saref4auto/Vehicle/"
     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:edintkos="https://edint.es/kos/"
     xmlns:edintveh="https://edint.es/def/censo-vehiculos#"
     xmlns:edinttraf="https://edint.es/def/trafico#"
     xmlns:edintzone="https://edint.es/def/zona-regulatoria#"
     xmlns:bibo="http://purl.org/ontology/bibo/" xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:widoco="https://w3id.org/widoco/vocab#">    <owl:Ontology rdf:about="https://edint.es/def/censo-vehiculos">
        <owl:versionIRI rdf:resource="https://edint.es/def/censo-vehiculos/0.2.1"/>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Daniel Doña</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Edna Ruckhaus</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Lucía Sánchez</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Maria del Socorro Bernardos</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Oscar Corcho</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:description xml:lang="es">El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de las entidades y datos principales del censo o registro de vehículos. Su alcance se limita a los datos que pueden ser utilizados con los propósitos de cobro de impuestos por parte de las entidades locales o de gestión de la movilidad (permisos de aparcamiento, permisos de acceso a zonas específicas, etc.), que son parte de las funciones habituales de las entidades locales. Quedan fuera del alcance de la ontología otros aspectos relacionados con los vehículos, como pueden ser los datos de sus permisos de circulación, inspecciones técnicas, etc., que podrían ser objeto de una extensión de esta ontología o de su evolución en el futuro, si se considera relevante.</dcterms:description>
        <dcterms:description xml:lang="en">The purpose of this ontology is to provide a common vocabulary for representing the main entities and data of the vehicle census or registry. Its scope is limited to the data that may be used for purposes such as tax collection by local authorities or mobility management (parking permits, access permits to specific zones, etc.), which are part of the usual functions of local entities. Other aspects related to vehicles, such as data concerning driving permits, technical inspections, and similar information, are outside the scope of this ontology. These could be addressed through an extension of this ontology or through its future evolution, if considered relevant.</dcterms:description>
        <dcterms:hasFormat>https://edint.es/def/censo-vehiculos.owl</dcterms:hasFormat>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="es">Ontología EDINT del Censo de Vehículos</dcterms:title>
        <dcterms:title xml:lang="en">EDINT Vehicle Census Ontology</dcterms:title>
        <vann:preferredNamespacePrefix>edintveh</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/censo-vehiculos#"/>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-censo-vehiculos/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-29</dcterms:created>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</dcterms:issued>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</dcterms:modified>
        <dcterms:publisher rdf:parseType="Resource">
            <foaf:name>FEMP</foaf:name>
            <foaf:homepage rdf:resource="https://www.femp.es/"/>
            <schema:affiliation>Federación Española de Municipios y Provincias</schema:affiliation>
        </dcterms:publisher>
    <dcterms:bibliographicCitation xml:lang="es">Ontología EDINT del Censo de Vehículos. EDINT. Revision: v0.1.0.</dcterms:bibliographicCitation>
    <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
    <dcterms:abstract xml:lang="es">El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de las entidades y datos principales del censo o registro de vehículos. Su alcance se limita a los datos que pueden ser utilizados con los propósitos de cobro de impuestos por parte de las entidades locales o de gestión de la movilidad (permisos de aparcamiento, permisos de acceso a zonas específicas, etc.), que son parte de las funciones habituales de las entidades locales. Quedan fuera del alcance de la ontología otros aspectos relacionados con los vehículos, como pueden ser los datos de sus permisos de circulación, inspecciones técnicas, etc., que podrían ser objeto de una extensión de esta ontología o de su evolución en el futuro, si se considera relevante.</dcterms:abstract>
    <dcterms:abstract xml:lang="en">The purpose of this ontology is to provide a common vocabulary for representing the key entities and data associated with vehicle registration or vehicle census records. Its scope is limited to data used for local government functions such as tax collection and mobility management (e.g., parking permits, access permits for specific zones). Aspects such as vehicle registration certificates and technical inspection records fall outside the scope of this ontology, though they could be addressed through future extensions or updates if deemed relevant.</dcterms:abstract>
</owl:Ontology>
    <foaf:Organization rdf:about="https://oeg.fi.upm.es/">
        <foaf:name>Ontology Engineering Group, UPM</foaf:name>
    </foaf:Organization>
    


