ex:auto5 a edintveh:Permit ;
    rdfs:label "Permiso taller centro"@es ;
    edintveh:permitType permt:Garage ;
    edintveh:permitStatus permstat:Active ;
    edintveh:permitPeriodicity permp:Annual ;
    edintveh:beginningDate "2025-04-01"^^xsd:date ;
    edintveh:endingDate "2026-03-31"^^xsd:date ;
    edintveh:activationDate "2025-04-01"^^xsd:date ;
    edintveh:authorisesVehicle ex:veh5 ;
    edintveh:authorisesInSegment ex:tramo2 ;
    edintveh:authorisesInZone ex:zona2 ;
    edintveh:permitOwner ex:propietario6 .

# ===================================================================
# Vehículo 6: Autobús híbrido no enchufable con distintivo C
