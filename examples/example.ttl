    edintveh:authorisesInZone ex:zona1 ;
    edintveh:permitOwner ex:propietario7 .

# ===================================================================
# Tramos de vía (StreetSection) para VEH04, VEH06, VEH22
# ===================================================================

ex:tramo1 a edinttraf:StreetSection ;
    rdfs:label "Calle Gran Vía, 1-100"@es .

ex:tramo2 a edinttraf:StreetSection ;
    rdfs:label "Paseo del Prado, 1-50"@es .

# ===================================================================
# Zonas regulatorias (TrafficControlledZone) para VEH05, VEH17, VEH18,
#   VEH25, VEH26
# ===================================================================

ex:zona1 a edintzone:TrafficControlledZone ;
    rdfs:label "Zona ZBE Centro"@es .

ex:zona2 a edintzone:TrafficControlledZone ;
    rdfs:label "Zona Regulatoria Sur"@es .
