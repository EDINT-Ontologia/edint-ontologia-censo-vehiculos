@prefix : <https://edint.es/def/censo-vehiculos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://edint.es/def/censo-vehiculos#> .

<https://edint.es/def/censo-vehiculos> rdf:type owl:Ontology ;
                                        owl:versionIRI <https://edint.es/def/censo-vehiculos/0.2.1> ;
                                        <http://purl.org/dc/terms/abstract> "El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de las entidades y datos principales del censo o registro de vehículos. Su alcance se limita a los datos que pueden ser utilizados con los propósitos de cobro de impuestos por parte de las entidades locales o de gestión de la movilidad (permisos de aparcamiento, permisos de acceso a zonas específicas, etc.), que son parte de las funciones habituales de las entidades locales. Quedan fuera del alcance de la ontología otros aspectos relacionados con los vehículos, como pueden ser los datos de sus permisos de circulación, inspecciones técnicas, etc., que podrían ser objeto de una extensión de esta ontología o de su evolución en el futuro, si se considera relevante."@es ,
                                                                            "The purpose of this ontology is to provide a common vocabulary for representing the key entities and data associated with vehicle registration or vehicle census records. Its scope is limited to data used for local government functions such as tax collection and mobility management (e.g., parking permits, access permits for specific zones). Aspects such as vehicle registration certificates and technical inspection records fall outside the scope of this ontology, though they could be addressed through future extensions or updates if deemed relevant."@en ;
                                        <http://purl.org/dc/terms/bibliographicCitation> "EDINT Vehicle Census Ontology. EDINT. Revision: v0.2.1."@en ,
                                                                                         "Ontología EDINT del Censo de Vehículos. EDINT. Revisión: v0.2.1."@es ;
                                        <http://purl.org/dc/terms/created> "2026-01-29"^^xsd:date ;
                                        <http://purl.org/dc/terms/creator> _:genid1 ,
                                                                           _:genid2 ,
                                                                           _:genid3 ,
                                                                           _:genid4 ,
                                                                           _:genid5 ;
                                        <http://purl.org/dc/terms/description> "El propósito de esta ontología es el de proporcionar un vocabulario común para la representación de las entidades y datos principales del censo o registro de vehículos. Su alcance se limita a los datos que pueden ser utilizados con los propósitos de cobro de impuestos por parte de las entidades locales o de gestión de la movilidad (permisos de aparcamiento, permisos de acceso a zonas específicas, etc.), que son parte de las funciones habituales de las entidades locales. Quedan fuera del alcance de la ontología otros aspectos relacionados con los vehículos, como pueden ser los datos de sus permisos de circulación, inspecciones técnicas, etc., que podrían ser objeto de una extensión de esta ontología o de su evolución en el futuro, si se considera relevante."@es ,
                                                                               "The purpose of this ontology is to provide a common vocabulary for representing the main entities and data of the vehicle census or registry. Its scope is limited to the data that may be used for purposes such as tax collection by local authorities or mobility management (parking permits, access permits to specific zones, etc.), which are part of the usual functions of local entities. Other aspects related to vehicles, such as data concerning driving permits, technical inspections, and similar information, are outside the scope of this ontology. These could be addressed through an extension of this ontology or through its future evolution, if considered relevant."@en ;
                                        <http://purl.org/dc/terms/issued> "2026-09-10"^^xsd:date ;
                                        <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                        <http://purl.org/dc/terms/modified> "2026-09-10"^^xsd:date ;
                                        <http://purl.org/dc/terms/publisher> _:genid6 ;
                                        <http://purl.org/dc/terms/title> "EDINT Vehicle Census Ontology"@en ,
                                                                         "Ontología EDINT del Censo de Vehículos"@es ;
                                        <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintveh" ;
                                        <http://purl.org/vocab/vann/preferredNamespaceUri> : ;
                                        rdfs:label "Censo de Vehículos"@es ,
                                                   "Vehicle Census"@en ;
                                        owl:priorVersion <https://github.com/EDINT-Ontologia/edint-ontologia-censo-vehiculos/releases/tag/v0.2.0> ;
                                        owl:versionInfo "0.2.1" ;
                                        <https://schema.org/codeRepository> <https://github.com/EDINT-Ontologia/edint-ontologia-censo-vehiculos> ;
                                        <https://schema.org/creativeWorkStatus> "Ontology Specification"@en ;
                                        <https://schema.org/funding> "Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)" ;
                                        <https://w3id.org/widoco/vocab#jsonldSerialization> "ontology.jsonld" ;
                                        <https://w3id.org/widoco/vocab#ntSerialization> "ontology.nt" ;
                                        <https://w3id.org/widoco/vocab#rdfxmlSerialization> "ontology.rdf" ;
                                        <https://w3id.org/widoco/vocab#turtleSerialization> "ontology.ttl" ;
                                        <https://w3id.org/widoco/vocab#vocabularyLabel> _:genid7 ,
                                                                                        _:genid8 .

_:genid1 <http://xmlns.com/foaf/0.1/name> "Daniel Doña" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid2 <http://xmlns.com/foaf/0.1/name> "Edna Ruckhaus" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid3 <http://xmlns.com/foaf/0.1/name> "Lucía Sánchez" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid4 <http://xmlns.com/foaf/0.1/name> "Maria del Socorro Bernardos" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid5 <http://xmlns.com/foaf/0.1/name> "Oscar Corcho" ;
          <https://schema.org/affiliation> <https://oeg.fi.upm.es/> .

_:genid6 <http://xmlns.com/foaf/0.1/homepage> <https://www.femp.es/> ;
          <http://xmlns.com/foaf/0.1/name> "FEMP" ;
          <https://schema.org/affiliation> "Federación Española de Municipios y Provincias" .

_:genid7 rdfs:label "SAREF4AUTO"@en ,
                     "SAREF4AUTO"@es ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <https://saref.etsi.org/saref4auto/Vehicle> .

_:genid8 rdfs:label "Traffic (edinttraf)"@en ,
                     "Tráfico (edinttraf)"@es ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <https://edint.es/def/trafico> .

