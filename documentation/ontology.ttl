#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#dateTime
xsd:dateTime owl:equivalentClass xsd:date .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty .


###  https://edint.es/def/censo-vehiculos#authorisesInSegment
:authorisesInSegment rdf:type owl:ObjectProperty ;
                     rdfs:domain :Permit ;
                     rdfs:range <https://edint.es/def/trafico#StreetSection> ;
                     rdfs:comment "Identifica el segmento de vía para el cual la autorización da permiso para pasar o aparcar"@es ,
                                  "It identifies a segment where the permit authorises the vehicle to go through or park"@en ;
                     rdfs:label "authorises in segment"@en ,
                                "autoriza en tramo"@es .


###  https://edint.es/def/censo-vehiculos#authorisesVehicle
:authorisesVehicle rdf:type owl:ObjectProperty ;
                   rdfs:domain :Permit ;
                   rdfs:range :Vehicle ;
                   rdfs:comment "Identifica el vehículo al que se refiere la autorización"@es ,
                                "It identifies the vehicle for which the permit is issued"@en ;
                   rdfs:label "authorises vehicle"@en ,
                              "autoriza vehículo"@es .


###  https://edint.es/def/censo-vehiculos#environmentalBadge
:environmentalBadge rdf:type owl:ObjectProperty ;
                    rdfs:domain :Vehicle ;
                    rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                        owl:hasValue <https://edint.es/kos/VehicleEnvironmentalBadge>
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
                    rdfs:comment "Distintivo ambiental asignado a un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, ECO, B, C, etc.)"@es ,
                                 "Environmental badge assigned to a vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., ECO, B, C, etc.)."@en ;
                    rdfs:label "distintivo ambiental del vehículo"@es ,
                               "environmental badge"@en .


###  https://edint.es/def/censo-vehiculos#permitOwner
:permitOwner rdf:type owl:ObjectProperty ;
             rdfs:domain :Permit ;
             rdfs:range :Owner ;
             rdfs:comment "Identifica al titular (persona u organización) para el cual la autorización está expedida"@es ,
                          "It identifies the person or organisation for which the permit has been issued"@en ;
             rdfs:label "permit owner"@en ,
                        "titular autorización"@es .


###  https://edint.es/def/censo-vehiculos#permitPeriodicity
:permitPeriodicity rdf:type owl:ObjectProperty ;
                   rdfs:domain :Permit ;
                   rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                       owl:hasValue <https://edint.es/kos/VehiclePermitPeriodicity>
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
                   rdfs:comment "Identifica la periodicidad de la autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, mensual, anual, etc.)"@es ,
                                "It identifies the periodicity of a vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., monhtly, annual, etc.)."@en ;
                   rdfs:label "periodicidad de la autorización"@es ,
                              "permit periodicity"@en .


###  https://edint.es/def/censo-vehiculos#permitStatus
:permitStatus rdf:type owl:ObjectProperty ;
              rdfs:domain :Permit ;
              rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                  owl:hasValue <https://edint.es/kos/VehiclePermitStatus>
                                                ]
                                              ) ;
                           rdf:type owl:Class
                         ] ;
              rdfs:comment "Identifica el estado de la autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, activo, inactivo, rechazado, etc.)"@es ,
                           "It identifies the status of a vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., active, inactive, rejected, etc.)."@en ;
              rdfs:label "estado de autorización"@es ,
                         "permit status"@en .


###  https://edint.es/def/censo-vehiculos#permitType
:permitType rdf:type owl:ObjectProperty ;
            rdfs:domain :Permit ;
            rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                owl:hasValue <https://edint.es/kos/VehiclePermitType>
                                              ]
                                            ) ;
                         rdf:type owl:Class
                       ] ;
            rdfs:comment "Identifica el tipo de autorización para un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización."@es ,
                         "It identifies the type of vehicle permit. The range is a SKOS concept that belongs to a controlled list of permit types."@en ;
            rdfs:label "permit type"@en ,
                       "tipo de autorizacion"@es .


###  https://edint.es/def/censo-vehiculos#propulsionType
:propulsionType rdf:type owl:ObjectProperty ;
                rdfs:domain :Vehicle ;
                rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                    owl:hasValue <https://edint.es/kos/VehiclePropulsionType>
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
                rdfs:comment "Propulsion type of a vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., Diesel, Petrol, Electrical, etc.)."@en ,
                             "Tipo de propulsión de un vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, diésel, gasolina, eléctrico, etc.)"@es ;
                rdfs:label "propulsion type"@en ,
                           "tipo de propulsión"@es .


###  https://edint.es/def/censo-vehiculos#registeredOwner
:registeredOwner rdf:type owl:ObjectProperty ;
                 rdfs:domain :Vehicle ;
                 rdfs:range :Owner ;
                 rdfs:comment "Identifica al titular (persona u organización) del vehículo"@es ,
                              "It identifies the person or organisation who owns the vehicle"@en ;
                 rdfs:label "registered owner"@en ,
                            "titular registrado"@es .


###  https://edint.es/def/censo-vehiculos#vehicleType
:vehicleType rdf:type owl:ObjectProperty ;
             rdfs:domain :Vehicle ;
             rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                 owl:hasValue <https://edint.es/kos/VehicleType>
                                               ]
                                             ) ;
                          rdf:type owl:Class
                        ] ;
             rdfs:comment "Tipo de vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de autorización (por ejemplo, turismo, furgoneta, caravana, etc.)"@es ,
                          "Type of vehicle. The range is a SKOS concept that belongs to a controlled list of permit types (e.g., van, truck, caravan, etc.)."@en ;
             rdfs:label "tipo de vehículo"@es ,
                        "vehicle type"@en .


#################################################################
#    Data properties
#################################################################

###  https://edint.es/def/censo-vehiculos#activationDate
:activationDate rdf:type owl:DatatypeProperty ;
                rdfs:domain :Permit ;
                rdfs:range xsd:date ;
                rdfs:comment "La fecha de activación de la autorización."@es ,
                             "The date on which the authorization is activated."@en ;
                rdfs:label "Date of Activation"@en ,
                           "Fecha de activación"@es .


###  https://edint.es/def/censo-vehiculos#beginningDate
:beginningDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Permit ;
               rdfs:range xsd:date ;
               rdfs:comment "Fecha de inicio del periodo de la autorización."@es ,
                            "Starting date of the authorization period."@en ;
               rdfs:label "Fecha de inicio"@es ,
                          "Beginning Date" .


###  https://edint.es/def/censo-vehiculos#endingDate
:endingDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Permit ;
            rdfs:range xsd:date ;
            rdfs:comment "Fecha de finalización de vigencia de la autorización"@es ,
                         "Permit expiration date"@en ;
            rdfs:label "Ending date"@en ,
                       "Fecha de finalización"@es .


###  https://edint.es/def/censo-vehiculos#licensePlateNumber
:licensePlateNumber rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Vehicle ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Alphanumeric identifier assigned to a vehicle for registration and identification purposes."@en ,
                                 "Identificador alfanumérico asignado a un vehículo para su registro e identificación"@es ;
                    rdfs:label "License Plate Number"@en ,
                               "Número de matrícula"@es .


#################################################################
#    Classes
#################################################################

###  http://vocab.ciudadesabiertas.es/def/transporte/trafico#Tramo
<http://vocab.ciudadesabiertas.es/def/transporte/trafico#Tramo> rdf:type owl:Class ;
                                                                rdfs:comment "Tramo definido por un punto de inicio y fin que puede pertenecer a una o más vías."@es ;
                                                                rdfs:isDefinedBy <http://vocab.ciudadesabiertas.es/def/transporte/trafico> ;
                                                                rdfs:label "Tramo"@es .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://edint.es/def/censo-vehiculos#Owner
:Owner rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Class ;
                         owl:unionOf ( <https://schema.org/Organization>
                                       <https://schema.org/Person>
                                     )
                       ] ;
       rdfs:comment "Person or organisation that is registered as the owner of a vehicle or of a vehicle permit"@en ,
                    "Persona u organización que está registrada como titular de un vehículo o como titular de una autorización para un vehículo"@es ;
       rdfs:label "Owner"@en ,
                  "Titular"@es .


###  https://edint.es/def/censo-vehiculos#Permit
:Permit rdf:type owl:Class ;
        rdfs:comment "Official permit, usually issued by the city council or the traffic authority, that allows a particular vehicle to access, drive through, or park in an area where entry is restricted or regulated"@en ,
                     "Permiso oficial, emitido normalmente por el ayuntamiento o la autoridad de tráfico, que habilita a un vehículo concreto a acceder, circular o estacionar en un área donde el acceso está restringido o regulado"@es ;
        rdfs:label "Autorización"@es ,
                   "Permit"@en .


###  https://edint.es/def/censo-vehiculos#Vehicle
:Vehicle rdf:type owl:Class ;
         rdfs:subClassOf <https://saref.etsi.org/saref4auto/Vehicle/Vehicle> ;
         rdfs:comment "Dispositivo de transporte autopropulsado, junto con cualquier accesorio, por ejemplo remolques, que es un usuario legal de la red de transporte (Fuente: ISO/TS 19091:2019(en))"@es ,
                      "Self-propelled transport device, along with any attachments, e.g. trailers, that is a legal user of the transportation network (Source: ISO/TS 19091:2019(en))."@en ;
         rdfs:label "Vehicle"@en ,
                    "Vehículo"@es .


###  https://edint.es/def/trafico#StreetSection
<https://edint.es/def/trafico#StreetSection> rdf:type owl:Class .


###  https://edint.es/def/zona-regulatoria#RegulatedZone
<https://edint.es/def/zona-regulatoria#RegulatedZone> rdf:type owl:Class ;
                                                      rdfs:comment "Area a la que se aplica una regulacion o normativa particular."@es ,
                                                                   "Area to which a particular regulation or policy applies."@en ;
                                                      rdfs:label "Regulated Zone"@en ,
                                                                 "Zona regulatoria"@es .


###  https://saref.etsi.org/saref4auto/Vehicle/Vehicle
<https://saref.etsi.org/saref4auto/Vehicle/Vehicle> rdf:type owl:Class ;
                                                    rdfs:comment "Self-propelled transport device, along with any attachments, e.g. trailers, that is a legal user of the transportation network (Source: ISO/TS 19091:2019(en))." ;
                                                    rdfs:isDefinedBy <https://saref.etsi.org/saref4auto/> ;
                                                    rdfs:label "Vehicle"@en .


###  https://schema.org/Organization
<https://schema.org/Organization> rdf:type owl:Class ;
                                  rdfs:comment "An organization such as a school, NGO, corporation, club, etc."@en ,
