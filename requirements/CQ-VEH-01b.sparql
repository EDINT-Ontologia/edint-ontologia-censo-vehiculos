# VEH1b: Con nombre de titular (variante de VEH01)

PREFIX edintveh: <https://edint.es/def/censo-vehiculos#>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?owner ?ownerName
WHERE {
    <URI_DEL_VEHICULO> edintveh:registeredOwner ?owner .

    OPTIONAL {
        ?owner schema:name | rdfs:label ?ownerName .
    }
}
