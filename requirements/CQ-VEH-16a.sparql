# VEH16a: Periodicidad de todas las autorizaciones (variante de VEH16)

PREFIX edintveh: <https://edint.es/def/censo-vehiculos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?permit ?periodicity ?label
WHERE {
    ?permit a edintveh:Permit ;
            edintveh:permitPeriodicity ?periodicity .

    OPTIONAL { ?periodicity skos:prefLabel ?label . }
}
ORDER BY ?permit
